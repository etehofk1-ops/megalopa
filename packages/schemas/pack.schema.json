{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Megalopa Ontology Pack",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "description",
    "nodes",
    "edges",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_node_id",
          "relation_type",
          "target_node_id"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source_title",
          "source_type"
        ]
      }
    }
  }
}